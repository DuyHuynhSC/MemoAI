# MemoAI Environment Configuration

# Google Gemini API (dùng cho ASR nhận dạng giọng nói hoặc dịch)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible / Server nội bộ (Qwen 3.8, Ollama, LM Studio, vLLM)
# Ví dụ Ollama: http://localhost:11434/v1
# Ví dụ LM Studio: http://localhost:1234/v1
# Ví dụ Server Qwen nội bộ: http://192.168.x.x:8000/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=dummy_key
OPENAI_MT_MODEL=qwen2.5:latest

# Corporate Proxy & Custom CA (Cho mạng doanh nghiệp như Fujinet, FPT...)
# PROXY_ENABLED=true
# HTTP_PROXY=http://proxy2.fujinet.vn:8080
# HTTPS_PROXY=http://proxy2.fujinet.vn:8080
# NO_PROXY=localhost,127.0.0.1
# CA_CERT_PATH=C:\certs\fujinet.ca
# INSECURE_SKIP_VERIFY=false

